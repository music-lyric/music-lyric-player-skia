{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows Example",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "example-windows-build-release",
      "program": "${workspaceFolder}/out/example/build/windows-x64-release/music_lyric_player_example_windows.exe",
      "args": [],
      "cwd": "${workspaceFolder}/out/example/build/windows-x64-release",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Windows Example With Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "example-windows-build-release-debug",
      "program": "${workspaceFolder}/out/example/build/windows-x64-relwithdebinfo/music_lyric_player_example_windows.exe",
      "args": [],
      "cwd": "${workspaceFolder}/out/example/build/windows-x64-relwithdebinfo",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "enableDebugHeap": true,
      "logging": {
        "engineLogging": true,
        "threadExit": true
      },
      "symbolOptions": {
        "searchMicrosoftSymbolServer": true,
        "cachePath": "%TEMP%\\SymbolCache"
      }
    }
  ]
}
