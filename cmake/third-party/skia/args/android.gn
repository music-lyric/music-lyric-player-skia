target_os = "android"

ndk = getenv("SKIA_ANDROID_NDK_DIR")
assert(ndk != "", "SKIA_ANDROID_NDK_DIR is required")

# Vulkan reached the platform in Android 7.0, so the whole stack targets that as its minimum.
ndk_api = 24

skia_use_angle = false
skia_use_gl = true
skia_gl_standard = "gles"
skia_use_ndk_images = false
skia_use_perfetto = false
skia_use_vulkan = true
skia_use_webgl = false
skia_use_webgpu = false

skia_use_freetype = true
